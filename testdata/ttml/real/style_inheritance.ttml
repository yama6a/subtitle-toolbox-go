<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en">
  <head>
    <styling>
      <style xml:id="it" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:fontWeight="bold">
        <style tts:textDecoration="underline"/>
      </region>
    </layout>
  </head>
  <body style="it">
    <div>
      <p xml:id="c1" begin="00:00:01.000" end="00:00:02.000">The ferry leaves at noon.</p>
      <p xml:id="c2" begin="00:00:03.000" end="00:00:04.000" tts:fontStyle="normal">Tickets are sold on board.</p>
    </div>
    <div style="it" tts:fontStyle="normal">
      <p xml:id="c3" begin="00:00:05.000" end="00:00:06.000" region="r1">Mind the gap.</p>
      <p xml:id="c4" begin="00:00:07.000" end="00:00:08.000" tts:color="yellow">Platform <span tts:color="white">two</span></p>
    </div>
    <div tts:color="cyan">
      <p xml:id="c5" begin="00:00:09.000" end="00:00:10.000"><span style="it">Next stop</span> <span tts:color="white" tts:fontStyle="normal">harbour</span></p>
    </div>
  </body>
</tt>
