<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:itts="http://www.w3.org/ns/ttml/profile/imsc1#styling" ttp:timeBase="smpte" ttp:frameRate="24" ttp:frameRateMultiplier="999 1000" ttp:dropMode="nonDrop" xml:lang="en">
    <head>
        <styling>
            <style xml:id="normal" tts:fontFamily="sansSerif" tts:fontWeight="normal" tts:fontStyle="normal" tts:color="white" tts:fontSize="100%"/>
        </styling>
        <layout>
            <region xml:id="top" tts:origin="0% 0%" tts:extent="100% 15%" tts:textAlign="center" tts:displayAlign="before"/>
            <region xml:id="bottom" tts:origin="0% 85%" tts:extent="100% 15%" tts:textAlign="center" tts:displayAlign="after"/>
        </layout>
    </head>
    <body region="bottom" style="normal">
        <div>
            <p begin="00:00:02:00" end="00:00:04:12" region="top" itts:forcedDisplay="true">SECTOR 7 AHEAD</p>
            <p begin="00:00:05:00" end="00:00:07:18" region="bottom">We follow the river to the old mill.</p>
            <p begin="00:00:08:02" end="00:00:10:12" region="bottom">The road on the left is closed.</p>
            <p begin="00:00:11:00" end="00:00:13:06" region="top" itts:forcedDisplay="true">NO ENTRY<br/>AFTER DARK</p>
            <p begin="00:00:14:00" end="00:00:16:20" region="bottom" itts:forcedDisplay="false">Then we take the bridge.</p>
            <p begin="00:00:17:04" end="00:00:19:00" region="top" itts:forcedDisplay="true"><span tts:fontStyle="italic">Mill Road 2 km</span></p>
        </div>
    </body>
</tt>
