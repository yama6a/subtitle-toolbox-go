<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xml:lang="en">
  <body>
    <div>
      <p begin="00:00:01.000">The ferry is late today.</p>
      <p begin="00:00:03.000">It should arrive at noon.</p>
      <p begin="00:00:05.000" dur="">Please wait inside.</p>
      <p begin="00:00:07.000" end="00:00:08.000">Thank you.</p>
      <p begin="00:00:09.000">Have a good trip.</p>
    </div>
  </body>
</tt>
