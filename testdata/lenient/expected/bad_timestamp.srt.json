    "cues": [
        {
            "start": 1,
            "end": 3,
            "text": "Good morning."
        },
        {
            "start": 7,
            "end": 9,
            "text": "Fresh bread every day."
        },
        {
            "start": 10,
            "end": 12,
            "text": "See you tomorrow."
        }
    ],
    "warnings": [
        {
            "line": 6,
            "block": 1,
