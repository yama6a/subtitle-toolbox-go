<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en">
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:03.000">The library opens at nine.</p>
      <p begin="00:00:0x.000" end="00:00:06.000">Books are due on Monday.</p>
      <p begin="00:00:07.000">Quiet, please.</p>
      <p begin="00:00:10.000" end="00:00:12.000"><span tts:fontStyle="italic">The reading room</span> is upstairs.</p>
    </div>
  </body>
</tt>
