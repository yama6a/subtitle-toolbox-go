<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xml:lang="en">
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:03.000">Salt & pepper are on the table.</p>
      <p begin="00:00:04.000" end="00:00:06.000">Turn left<br>at the bakery.</p>
      <p begin="00:00:07.000" end="00:00:09.000">Tickets cost 5 &cur; at the door.</p>
      <p begin="00:00:10.000" end="00:00:12.000">The last bus <span>leaves at ten.</p>
    </div>
  </body>
</tt>
