#!/bin/sh
# Stands in for tesseract in tests. It prints the language, the page segmentation mode and the PGM size as words.
case "$1" in
    --version) echo "tesseract 5.5.0"; exit 0 ;;
    --list-langs) printf 'List of available languages in "/fake/" (3):\ndeu\neng\nosd\n'; exit 0 ;;
esac
if [ -n "$FAKE_TESSERACT_FAIL" ]; then
    echo "Error during processing." >&2
    exit 1
fi
image=$1
if [ -n "$FAKE_TESSERACT_LOG" ]; then
    echo "$image" > "$FAKE_TESSERACT_LOG"
fi
shift 2
while [ $# -gt 0 ]; do
    case "$1" in
        -l) language=$2; shift ;;
        --psm) psm=$2; shift ;;
    esac
    shift
done
size=$(sed -n 2p "$image" | tr ' ' x)
printf 'level\tpage_num\tblock_num\tpar_num\tline_num\tword_num\tleft\ttop\twidth\theight\tconf\ttext\n'
printf '1\t1\t0\t0\t0\t0\t0\t0\t100\t40\t-1\t\n'
printf '5\t1\t1\t1\t1\t1\t0\t0\t10\t10\t90\t%s\n' "$language"
printf '5\t1\t1\t1\t1\t2\t20\t0\t10\t10\t70\tpsm%s\n' "$psm"
printf '5\t1\t1\t1\t2\t1\t0\t20\t10\t10\t80\t%s\n' "$size"
